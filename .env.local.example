# Copy to .env.local and fill in your values.

# Required for admin login
JWT_SECRET_KEY=any-long-random-string-change-in-production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=run-script-below-to-generate

# Optional (TEMP ONLY): if set to "true", /admin routes and admin APIs won't require login.
# Turn this OFF before deploying.
# ADMIN_BYPASS_AUTH=true

# Optional: for persistent data (otherwise admin uses in-memory storage)
# NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
