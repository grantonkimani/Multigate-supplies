# Copy to .env.local and fill in your values.

# Required for admin login (always required; there is no bypass)
JWT_SECRET_KEY=any-long-random-string-change-in-production
ADMIN_USERNAME=MultigateAdmin
# Bcrypt hash without $ so .env does not eat it: 2a|cost|payload  (or 2b|12|...)
ADMIN_PASSWORD_HASH=2b|12|paste-the-53-character-bcrypt-payload

# Optional: for persistent data (otherwise admin uses local JSON storage)
# NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Email customers when payment is confirmed and when delivery status changes
# Use a Gmail App Password (not the normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=multigatemedicalsupplies@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=Multigate Medical Supplies <multigatemedicalsupplies@gmail.com>
